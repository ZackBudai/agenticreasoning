  have f2: "∀x. x ∈ A - B ⟹ x ∉ B" by simp
  have f3: "sum f (A - B) = sum f {x | x ∈ A ∧ x ∉ B}" using f1 unfolding indicator_def by auto
  have f4: "{x | x ∈ A ∧ x ∉ B} = A - B" by blast
  hence f5: "sum f (A - B) = sum f (A - B)" by simp
  show ?thesis
    sorry
    unfolding f3 f4 f5 by simp
qed

