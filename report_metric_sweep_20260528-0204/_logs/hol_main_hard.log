lemma "length xs = length ys \<Longrightarrow> P [] [] \<Longrightarrow> (\<And>x xs y ys. length xs = length ys \<Longrightarrow> P xs ys \<Longrightarrow> P (x#xs) (y#ys)) \<Longrightarrow> P xs ys"
proof -
  assume len_eq: "length xs = length ys" and base: "P [] []"
  define f where "f (x, y) = P [x] [y]"
  
  have induction_step:
    sorry
    "\<forall>x xs y ys. length xs = length ys \<Longrightarrow> P xs ys \<Longrightarrow> P (x#xs) (y#ys)"
    unfolding f_def
    by (auto simp: len_eq)
    
  from len_eq base induction_step show "P xs ys" .
qed

