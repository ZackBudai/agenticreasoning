lemma "card {T. T \<subseteq> S \<and> U \<subseteq> T \<and> even(card T)} = card {T. T \<subseteq> S \<and> U \<subseteq> T \<and> odd(card T)}"
proof -
  let ?A = "{T. T \<subseteq> S \<and> U \<subseteq> T \<and> even(card T)}"
  let ?B = "{T. T \<subseteq> S \<and> U \<subseteq> T \<and> odd(card T)}"
  
  have f1: "card ?A + card ?B = card (S - U) + card U"
    sorry
  
  have f2: "card (S - U) = card {T. T \<subseteq> S \<and> T \<inter> U = {}}"
    sorry
  
  have f3: "card U = card {T. T \<subseteq> U \<and> card T = 1}"
    sorry
  
  show ?thesis
    using f1 f2 f3 by simp
    sorry
qed

