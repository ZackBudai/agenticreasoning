lemma "prefix xs ys \<Longrightarrow> set xs \<subseteq> set ys"
proof -
  assume h1: "prefix xs ys"
  show ?thesis
    sorry
    unfolding prefix_def
    apply (induction xs arbitrary: ys)
    case Nil
    then have f1: "set [] \<subseteq> set ys"
      by simp
    show ?thesis
      using f1
      sorry
    next
    case (Cons x xs')
    with h1 obtain y ys'' where
      hy1: "ys = y # ys''" and
      hy2: "prefix xs' ys''" and
      hy3: "x = y"
      by auto
    from Cons have f2: "set (x#xs') \<subseteq> set ys"
      unfolding h2 prefix_def
      apply simp
      using hy3
      by fastforce
    show ?thesis
      using f2
      sorry
  qed

