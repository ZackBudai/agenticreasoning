lemma "(∀x. f x = g x) ⟶ (∃!x. f x = a) ⟶ (∃!x. g x = a)"
proof -
  assume "∀x. f x = g x" and "∃!x. f x = a"
  then obtain y where "f y = a" and "∀z. f z = a ⟹ z = y" by blast
  hence "g y = a" using `∀x. f x = g x` by simp
  with `f y = a` have "y = y" by simp
  thus "∃!x. g x = a" by (rule ex1I) (auto)
qed

