lemma "(∃!x. P x) ⟶ (∀x y. P x ∧ P y ⟶ x = y)"
proof -
  assume "∃!x. P x"
  then obtain x where "P x" and "∀y. P y ⟹ y = x" by blast
  fix x y
  assume "P x" and "P y"
  with `∀y. P y ⟹ y = x` have "y = x" by simp
  thus "x = y" .
qed

