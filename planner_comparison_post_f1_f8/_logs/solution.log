lemma "finite A ⟹ card (A ∪ B) = card A + card (B - A)"
proof -
  have f1: "A ⊆ A ∪ B" by auto
  have f2: "B ⊆ A ∪ B" by auto
  have f3: "A ∩ B ⊆ A" by auto
  have f4: "card (A ∪ B) = card (A ∪ B - A)" using f1 by simp
  also have "... = card (A ∪ B - (A ∩ B))" using f3 by simp
  also have "... = card ((A - A ∩ B) ∪ (B - A ∩ B))" by auto
  also have "... = card (A - A ∩ B) + card (B - A ∩ B)" using finite_Un_disjoint f1 f2 by blast
  finally show ?thesis 

qed

