lemma "finite A ⟹ sum (λx. c::int) A = c * int (card A)"
proof -
  have f1: "∀x∈A. c = c" by simp
  have f2: "sum (λx. c) A = card A * c"
    apply (induction A arbitrary: c)
    case empty
    show ?thesis by simp
  next
    case (insert x A)
    have f3: "c = c" by simp
    have f4: "card (insert x A) = Suc (card A)" by simp
    have f5: "sum (λx. c) (insert x A) = sum (λx. c) A + c"
      apply (rule insert)
      using f3
      done
    show ?thesis
      using f4 f5 insert.prems f1
      by (auto simp add: algebra_simps)
  qed

