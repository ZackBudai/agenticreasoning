lemma "(P ⟶ (Q ⟶ R)) ⟷ ((P ∧ Q) ⟶ R)"
proof -
  assume "P ⟶ (Q ⟶ R)" and "P ∧ Q"
  then have "Q ⟶ R" by simp
  with `P ∧ Q` have "R" by simp
  thus "(P ∧ Q) ⟶ R" by simp

  assume "(P ∧ Q) ⟶ R"
  show "P ⟶ (Q ⟶ R)"
  proof -
    assume P
    assume Q
    from `(P ∧ Q) ⟶ R` and `P ∧ Q` have "R" by simp
    thus "R" by simp
  qed
qed

